{
  "name": "julias-page",
  "version": "1.0.0",
  "description": "Julia's custom website solutions landing page.",
  "private": true,
  "scripts": {
    "start": "webpack serve --output-path ./build --mode development",
    "build": "webpack --mode=development --output-path ./build",
    "build:prod": "webpack --mode=production --output-path ./build",
    "test": "jest --coverage --config=jest.unit.config.js",
    "test:watch": "jest --watch --collect-coverage --config=jest.unit.config.js",
    "clean": "rm -rf build",
    "compile": "tsc",
    "lint": "eslint ./src --ext .js,.ts,.tsx",
    "lint:fix": "eslint --fix ./src --ext .js,.ts,.tsx",
    "p:check": "prettier --check ./src",
    "p:format": "prettier --write ./src"
  },
  "author": "Julia",
  "license": "ISC",
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router": "~5.3.4",
    "react-router-dom": "~5.3.4",
    "styled-components": "~6.1.8"
  },
  "devDependencies": {
    "@babel/core": "~7.24.4",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "~7.24.1",
    "@babel/preset-typescript": "~7.24.1",
    "@testing-library/dom": "~9.3.4",
    "@testing-library/jest-dom": "~6.4.2",
    "@testing-library/react": "~15.0.2",
    "@testing-library/user-event": "~14.5.2",
    "@types/jest": "~29.5.12",
    "@types/node": "~18.19.31",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "@types/react-router-dom": "~5.3.3",
    "@types/styled-components": "~5.1.34",
    "@typescript-eslint/eslint-plugin": "~7.7.0",
    "@typescript-eslint/parser": "~7.7.0",
    "babel-loader": "~9.1.3",
    "css-loader": "~6.11.0",
    "dotenv": "~16.4.5",
    "dotenv-webpack": "~8.1.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-jest": "~28.2.0",
    "eslint-plugin-react": "~7.34.1",
    "html-webpack-plugin": "~5.6.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-html-reporters": "~3.1.7",
    "jest-junit": "~16.0.0",
    "prettier": "~3.2.5",
    "source-map-loader": "~5.0.0",
    "style-loader": "~4.0.0",
    "ts-jest": "~29.1.2",
    "ts-loader": "~9.5.1",
    "typescript": "~5.4.5",
    "webpack": "~5.91.0",
    "webpack-cli": "~5.1.4",
    "webpack-dev-server": "~5.0.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  }
}
