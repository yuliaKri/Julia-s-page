{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react",
    "module": "ESNext",
    "lib": ["dom", "esnext"],
    "noImplicitAny": true,
    "outDir": "./build/",
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "es6",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "@testing-library/jest-dom", "node", "@types/jest"]
  },
  "include": ["src/"]
}
